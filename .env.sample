# Required workspace source root: absolute, outside this project, reachable by Docker Desktop.
GODOO_SOURCES_ROOT=/Users/you/dev/sources
# ODOO_MANIFEST defaults to ./odoo_manifest.yml.

# Required runtime/database values. Provide downstream secrets outside source control.
ODOO_MAIN_DB=odoo
ODOO_DB_FILTER=odoo
ODOO_DB_PASSWORD=change-me
ODOO_DB_USER=odoo_user
ODOO_DB_HOST=db
ODOO_DB_PORT=5432

# Runtime path overrides; representative downstream defaults are explicit.
# ODOO_MAIN_FOLDER=/odoo/odoo
# ODOO_WORKSPACE_ADDON_LOCATION=/odoo/godoo_workspace/addons
# ODOO_CONF_PATH=/odoo/config/odoo.conf
# ODOO_DATA_DIR=/var/lib/odoo
# GODOO_X_SENDFILE=true
# GODOO_REPORT_URL=http://nginx

# Runtime lifecycle overrides. Hook directories must exist in the runtime environment.
# GODOO_RUNTIME_SEED=/odoo_restore/runtime.zip
# GODOO_AFTER_BOOTSTRAP_DIRS=/odoo/godoo_workspace/hooks/after-bootstrap
# GODOO_AFTER_RESTORE_DIRS=/odoo/godoo_workspace/hooks/after-restore
# GODOO_AFTER_RECONCILE_DIRS=/odoo/godoo_workspace/hooks/after-reconcile

# Optional XML-RPC connection.
# ODOO_RPC_HOST=http://localhost:8069
# ODOO_RPC_USER=admin
# ODOO_RPC_PASSWORD=admin
# ODOO_RPC_DB_NAME=odoo
